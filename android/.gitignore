# Build output and local machine files — never commit these.
.gradle/
build/
/captures
.externalNativeBuild
.cxx
local.properties
*.apk
*.aab
*.ap_

# Signing keys — keep these out of Git. GitHub stores them as encrypted secrets.
*.jks
*.keystore

# Rebuilt from the web app every time `npx cap sync android` runs.
app/src/main/assets/public
app/src/main/assets/capacitor.config.json
app/src/main/assets/capacitor.plugins.json
app/src/main/res/xml/config.xml

# Android Studio
.idea/
*.iml
